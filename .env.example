# ============================================================
# Coter Pro — Variables de Entorno
# Copia este archivo a .env y configura los valores
# ============================================================

# Entorno: development | production | test
NODE_ENV=development

# Puerto del servidor
PORT=3000

# Imagen inmutable de GHCR para producción (tag de release o digest, nunca :main)
API_IMAGE=ghcr.io/bamontejano78-svg/coter:REEMPLAZAR_CON_TAG_DE_RELEASE

# ─── BASE DE DATOS ───────────────────────────────────────────
# PostgreSQL connection string
# Desarrollo local: usa DATABASE_URL o docker-compose.local.yml.
# Producción con Docker Compose: DB_PASSWORD es obligatorio y Compose
# construye DATABASE_URL dentro de la red privada. No pongas credenciales
# reales en este archivo.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/coter
DB_PASSWORD=REEMPLAZAR_CON_PASSWORD_HEX_DE_24_BYTES

# Pool de conexiones
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=15000

# ─── JWT ────────────────────────────────────────────────────
# Genera un JWT_SECRET con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REEMPLAZAR_CON_SECRETO_DE_64_BYTES
JWT_EXPIRES_IN=30d

# Tiempo de vida de refresh tokens en días (30 prod, 90 dev)
REFRESH_TOKEN_DAYS=30

# ─── Encriptación ───────────────────────────────────────────
# Clave AES-256-GCM: exactamente 64 caracteres hexadecimales (32 bytes)
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=REEMPLAZAR_CON_64_HEX_CHARS

# ─── CORS ────────────────────────────────────────────────────
# Orígenes permitidos (separados por coma)
# Desarrollo: http://localhost:3000,http://localhost:8080
# Producción: https://coter.app,https://app.coter.app
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000

# ─── EMAIL (Verificación de email y recuperación de contraseña) ──────────────
# Obligatorio en producción para verificación de email y recuperación de contraseña.
# Sin SMTP configurado en desarrollo, las URLs de verificación/reset se devuelven
# en la respuesta del API (solo en NODE_ENV=development).
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=REEMPLAZAR_CON_API_KEY_DE_SMTP
SMTP_FROM=noreply@coter.app

# URL pública de la aplicación (para links en emails de verificación y reset)
# En producción debe ser la URL real: https://coter.app
APP_URL=http://localhost:3000

# Email donde se notifican las solicitudes de Pioneros
PIONEER_NOTIFY_EMAIL=equipo@coter.app

# ─── ADMIN PANEL ────────────────────────────────────────────
# Contraseña para acceder al panel de administración (/admin)
ADMIN_PASSWORD=REEMPLAZAR_CON_PASSWORD_ADMIN_LARGA_Y_ALEATORIA

# ─── RATE LIMITING ───────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── BACKUPS ─────────────────────────────────────────────────
# Directorio donde se guardan los backups de BD
# BACKUP_DIR=backups/

# Bucket S3 para backups (opcional, requiere AWS CLI)
# S3_BACKUP_BUCKET=coter-backups

# ─── LOGGING ─────────────────────────────────────────────────
LOG_LEVEL=info

# ─── STRIPE ───
STRIPE_SECRET_KEY=REEMPLAZAR_CON_CLAVE_STRIPE
STRIPE_WEBHOOK_SECRET=REEMPLAZAR_CON_SECRETO_WEBHOOK_STRIPE
STRIPE_PRICE_ID=REEMPLAZAR_CON_PRICE_ID_STRIPE

# ─── FIREBASE CLOUD MESSAGING ─────────────────────────────────
# Server Key: Firebase Console → Project Settings → Cloud Messaging → Server key
# Sender ID: Firebase Console → Project Settings → Cloud Messaging → Sender ID
FCM_SERVER_KEY=REEMPLAZAR_CON_CREDENCIAL_FCM
FCM_SENDER_ID=REEMPLAZAR_CON_SENDER_ID_FCM
