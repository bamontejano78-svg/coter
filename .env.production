# ============================================================
# Coter Pro — Variables de Entorno para PRODUCCIÓN
# ============================================================
# Copia este archivo al servidor como .env y completa los valores.
# NUNCA commitees este archivo con valores reales al repositorio.
# ============================================================

# ─── Entorno ──────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ─── Base de Datos (PostgreSQL) ───────────────────────────────
# Usa la URL de conexión de tu proveedor (Neon, Railway, Supabase, etc.)
# ⚠️ DEBE ser diferente de la BD de staging/test
DATABASE_URL=postgresql://coter:TU_PASSWORD_SEGURO@postgres:5432/coter

# Pool de conexiones (ajustar según el plan de BD)
DB_POOL_MIN=4
DB_POOL_MAX=20
DB_CONNECTION_TIMEOUT_MS=15000

# ─── JWT ──────────────────────────────────────────────────────
# Generar con: openssl rand -hex 64
JWT_SECRET=REEMPLAZAR_CON_64_BYTES_HEX
JWT_EXPIRES_IN=30d
REFRESH_TOKEN_DAYS=30

# ─── Encriptación (AES-256-GCM) ───────────────────────────────
# Generar con: openssl rand -hex 32
ENCRYPTION_KEY=REEMPLAZAR_CON_32_BYTES_HEX_64_CHARS

# ─── CORS ─────────────────────────────────────────────────────
# Dominios de producción (separados por coma)
CORS_ORIGINS=https://coter.app,https://app.coter.app

# ─── Email (SMTP) ─────────────────────────────────────────────
# ⚠️ REQUERIDO en producción para recuperación de contraseña
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=REEMPLAZAR_CON_API_KEY_DE_RESEND
SMTP_FROM=noreply@coter.app

# URL pública de la aplicación (para links en emails)
APP_URL=https://coter.app

# Email donde se notifican las solicitudes de Pioneros
PIONEER_NOTIFY_EMAIL=equipo@coter.app

# ─── Admin Panel ──────────────────────────────────────────────
ADMIN_PASSWORD=REEMPLAZAR_CON_PASSWORD_SEGURO

# ─── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── Cron ─────────────────────────────────────────────────────
# Frecuencia de tareas programadas (formato cron)
# Recordatorios de tareas: cada hora
CRON_REMINDERS=0 * * * *
# Facturación: día 1 de cada mes a las 3am
CRON_BILLING=0 3 1 * *

# ─── Stripe ───────────────────────────────────────────────────
# ⚠️ REQUERIDO en producción para pagos
# Claves de producción (sk_live_..., no sk_test_...)
STRIPE_SECRET_KEY=sk_live_REEMPLAZAR
STRIPE_WEBHOOK_SECRET=whsec_REEMPLAZAR
STRIPE_PRICE_ID=price_REEMPLAZAR

# ─── Firebase Cloud Messaging ──────────────────────────────────
# ⚠️ REQUERIDO para notificaciones push
# Server Key: Firebase Console → Project Settings → Cloud Messaging
FCM_SERVER_KEY=AAAA_REEMPLAZAR
FCM_SENDER_ID=396430726535

# ─── Logging ──────────────────────────────────────────────────
LOG_LEVEL=info
