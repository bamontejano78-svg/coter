# ============================================================
# Coter Pro — Variables de Entorno (Staging)
# Copia este archivo a .env.staging en el host de staging.
# No lo rellenes con secretos reales dentro del repositorio.
# ============================================================

NODE_ENV=staging

# PostgreSQL local del compose; DATABASE_URL se construye con DB_PASSWORD.
DB_PASSWORD=REEMPLAZAR_CON_PASSWORD_HEX_DE_24_BYTES
API_IMAGE=ghcr.io/bamontejano78-svg/coter:REEMPLAZAR_CON_SHA_O_TAG

# Seguridad (genera valores aleatorios; no reutilices producción).
JWT_SECRET=REEMPLAZAR_CON_SECRETO_ALEATORIO_DE_64_BYTES
ENCRYPTION_KEY=REEMPLAZAR_CON_64_HEX_CHARS
ADMIN_PASSWORD=REEMPLAZAR_CON_PASSWORD_DE_AL_MENOS_16_CARACTERES
REFRESH_TOKEN_DAYS=30

# URLs públicas de staging, siempre HTTPS salvo pruebas locales.
APP_URL=https://staging.example.com
CORS_ORIGINS=https://staging.example.com

# SMTP real de staging para probar recuperación de contraseña.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=REEMPLAZAR_CON_API_KEY_SMTP_STAGING
SMTP_FROM=staging@coter.app

# Stripe TEST; no uses claves live en staging.
STRIPE_SECRET_KEY=sk_test_REEMPLAZAR
STRIPE_WEBHOOK_SECRET=whsec_REEMPLAZAR
STRIPE_PRICE_ID=price_REEMPLAZAR

# Opcional: notificaciones push.
FCM_SERVER_KEY=
FCM_SENDER_ID=
PIONEER_NOTIFY_EMAIL=

# Operación.
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
REFRESH_TOKEN_DAYS=30
CRON_REMINDERS=
CRON_BILLING=
CRON_ALERTS=
CRON_REMINDERS_RUN_AT_START=false
